# Copie este archivo como .env y reemplace los valores. El .env real NO se versiona (.gitignore).
# Evite en las contraseñas los caracteres ; ' " y espacios (rompen la cadena de conexión o el script SQL).

# Contraseña del administrador de SQL Server (mín. 8 caracteres, mayúsculas, minúsculas, números y símbolos).
MSSQL_SA_PASSWORD=Cambiar-Sa-2026!

# Base de datos y login de mínimos privilegios que usa la API.
DB_NAME=PedidosDb
APP_DB_USER=pedidos_app
APP_DB_PASSWORD=Cambiar-App-2026!

# Clave de firma del JWT (HS256): mínimo 32 caracteres aleatorios. Generar, por ejemplo, con:
#   openssl rand -base64 48
JWT_KEY=reemplazar-por-una-clave-aleatoria-de-al-menos-32-caracteres

# Clave maestra de 32 bytes en Base64: cifra los secretos del 2FA y firma códigos y enlaces de recuperación.
# El valor de ejemplo sirve para probar; en cualquier otro uso genere una propia con:
#   openssl rand -base64 32
SEGURIDAD_CLAVE_MAESTRA=Q2FtYmlhci1lc3RhLWNsYXZlLWRlLTMyLWJ5dGVzISE=

# Puertos y orígenes vistos desde el navegador.
API_PORT=5080
API_PUBLIC_URL=http://localhost:5080
FRONTEND_ORIGIN=http://localhost:8080
